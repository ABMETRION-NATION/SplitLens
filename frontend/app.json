{
  "expo": {
    "name": "SplitLens",
    "slug": "splitlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splitlens",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitlens.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach receipt photos to split bills",
        "NSCameraUsageDescription": "Capture receipts to detect totals automatically"
      }
    },
    "android": {
      "package": "com.splitlens.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090B"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach receipt photos to split bills",
          "cameraPermission": "Capture receipts to detect totals automatically"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
